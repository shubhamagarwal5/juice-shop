# Based on Juice Shop's upstream .dockerignore, with one key difference:
# node_modules/, frontend/dist/ and build/ are NOT ignored, because the pipeline
# compiles them in CI (through Artifactory) and the image only packages the result.

# Source control, CI and local tooling
.git/
.github/
.jfrog/
.npmrc
.idea/
.ai/
.claude/
.codeium/
.continue/
.cursor/
.junie/
.playwright-mcp/
.devcontainer.json
.mailmap

# Not needed at runtime
.nyc_output
/bom.json
/bom.xml
build/reports/
coverage/
cypress/
dist/
frontend/.angular/
frontend/node_modules/
frontend/src/assets/
monitoring/
rsn/
screenshots/
scripts/
terraform/
test/
vagrant/
k8s/
Dockerfile
xray-*.json
